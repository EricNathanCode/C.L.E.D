[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://gamemode/scripts/GM_UpdateSet.gd" id="1"]

[node name="GM_UpdateSet" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Description" type="Label" parent="."]
unique_name_in_owner = true
text = "Description goes here."
autowrap_mode = 3

[node name="TableLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "TABLE: [table]"

[node name="DataTable" type="VBoxContainer" parent="."]
unique_name_in_owner = true
theme_override_constants/separation = 0

[node name="QueryLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "> Fill in the blanks:"

[node name="SQLTerminal" type="PanelContainer" parent="."]
unique_name_in_owner = true

[node name="SQLBlock" type="VBoxContainer" parent="SQLTerminal"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="Line1" type="RichTextLabel" parent="SQLTerminal/SQLBlock"]
bbcode_enabled = true
text = "[color=#6BB0E8]UPDATE[/color] [color=#F5BF4D][table][/color]"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="Line2" type="HBoxContainer" parent="SQLTerminal/SQLBlock"]
theme_override_constants/separation = 2

[node name="SetKeyword" type="RichTextLabel" parent="SQLTerminal/SQLBlock/Line2"]
bbcode_enabled = true
text = "[color=#6BB0E8]SET[/color] [color=#F5BF4D][column][/color] = '"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="Blank1" type="LineEdit" parent="SQLTerminal/SQLBlock/Line2"]
placeholder_text = "new value"
custom_minimum_size = Vector2(150, 0)
max_length = 60

[node name="Quote" type="Label" parent="SQLTerminal/SQLBlock/Line2"]
text = "'"

[node name="Line3" type="HBoxContainer" parent="SQLTerminal/SQLBlock"]
theme_override_constants/separation = 2

[node name="WhereKeyword" type="RichTextLabel" parent="SQLTerminal/SQLBlock/Line3"]
bbcode_enabled = true
text = "[color=#6BB0E8]WHERE[/color] [color=#F5BF4D]id[/color] ="
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="Blank2" type="LineEdit" parent="SQLTerminal/SQLBlock/Line3"]
placeholder_text = "id"
custom_minimum_size = Vector2(60, 0)
max_length = 10

[node name="Semicolon" type="Label" parent="SQLTerminal/SQLBlock/Line3"]
text = ";"

[node name="HintLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Hint: (hint goes here)"
visible = false

[node name="ResultBox" type="VBoxContainer" parent="."]
unique_name_in_owner = true
theme_override_constants/separation = 4
visible = false

[node name="ButtonRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
theme_override_constants/separation = 8

[node name="ExecuteButton" type="Button" parent="ButtonRow"]
unique_name_in_owner = true
text = "Execute"

[node name="HintButton" type="Button" parent="ButtonRow"]
unique_name_in_owner = true
text = "Hint"

[node name="ContinueButton" type="Button" parent="."]
unique_name_in_owner = true
text = "Continue Story"
visible = false
